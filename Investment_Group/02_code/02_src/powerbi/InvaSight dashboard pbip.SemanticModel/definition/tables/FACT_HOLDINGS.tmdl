table FACT_HOLDINGS
	lineageTag: 54da1e02-53ed-4467-a392-831268c2fd88

	measure 'Buy Value (SAR)' = CALCULATE ( SUMX ( FACT_HOLDINGS, ABS ( FACT_HOLDINGS[VALUE_SAR] ) ), FACT_HOLDINGS[TRANSACTION_TYPE] = "BUY" )
		formatString: #,0
		displayFolder: Trading
		lineageTag: 4b2a3389-fb00-49d2-8c35-a1f6671ad3b1

	measure 'Sell Value (SAR)' = CALCULATE ( SUMX ( FACT_HOLDINGS, ABS ( FACT_HOLDINGS[VALUE_SAR] ) ), FACT_HOLDINGS[TRANSACTION_TYPE] = "SELL" )
		formatString: #,0
		displayFolder: Trading
		lineageTag: c941409c-2e68-4f51-b614-61b722d57d05

	measure 'Net Invested (SAR)' = [Buy Value (SAR)] - [Sell Value (SAR)]
		formatString: #,0
		displayFolder: Trading
		lineageTag: 196c4808-da9f-4bc2-b0c0-e8177c9488eb

	measure 'Traded Volume (SAR)' = SUMX ( FACT_HOLDINGS, ABS ( FACT_HOLDINGS[VALUE_SAR] ) )
		formatString: #,0
		displayFolder: Trading
		lineageTag: f9f71c6b-983c-4f5c-8308-68a8c63fdeb1

	measure Transactions = COUNTROWS ( FACT_HOLDINGS )
		formatString: #,0
		displayFolder: Trading
		lineageTag: 3320c11e-d6ca-4c1a-affc-3aef5736575d

	measure 'Transaction Fees' = SUM ( FACT_HOLDINGS[FEES] )
		formatString: #,0
		displayFolder: Trading
		lineageTag: a5141bec-d794-402c-b569-3a323c9bd845

	measure 'CF Net Invested Color' =
			VAR v = [Net Invested (SAR)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 0237bd31-8224-4984-8584-da2b8d9d3f7e

	measure 'Current Holdings Value (SAR)' =
			VAR ValuationDate = MAX ( DIM_DATE[FULL_DATE] )
			RETURN
			    SUMX (
			        KEEPFILTERS ( VALUES ( DIM_ASSET[ASSET_KEY] ) ),
			        VAR CurrentQty =
			            CALCULATE (
			                SUM ( FACT_HOLDINGS[QUANTITY] ),
			                FACT_HOLDINGS[TRANSACTION_TYPE] = "BUY",
			                REMOVEFILTERS ( DIM_DATE ),
			                DIM_DATE[FULL_DATE] <= ValuationDate
			            )
			            - CALCULATE (
			                SUM ( FACT_HOLDINGS[QUANTITY] ),
			                FACT_HOLDINGS[TRANSACTION_TYPE] = "SELL",
			                REMOVEFILTERS ( DIM_DATE ),
			                DIM_DATE[FULL_DATE] <= ValuationDate
			            )
			        VAR PriceDate =
			            CALCULATE (
			                MAXX ( FACT_MARKET_PRICES, RELATED ( DIM_DATE[FULL_DATE] ) ),
			                REMOVEFILTERS ( DIM_DATE ),
			                DIM_DATE[FULL_DATE] <= ValuationDate,
			                REMOVEFILTERS ( DIM_CURRENCY )
			            )
			        VAR LatestPriceSAR =
			            CALCULATE (
			                AVERAGEX ( FACT_MARKET_PRICES, FACT_MARKET_PRICES[PRICE_SAR] ),
			                REMOVEFILTERS ( DIM_DATE ),
			                DIM_DATE[FULL_DATE] = PriceDate,
			                REMOVEFILTERS ( DIM_CURRENCY )
			            )
			        RETURN
			            IF ( CurrentQty <> 0, CurrentQty * LatestPriceSAR )
			    )
		formatString: #,0
		displayFolder: Currency
		lineageTag: 6f1d2a4e-8b3c-4d7e-9a15-2c4b7e9d0f31

	measure 'Current FX Exposure (SAR)' =
			CALCULATE (
			    SUM ( 'FACT_HOLDINGS'[VALUE_SAR] ),
			    'FACT_HOLDINGS'[TRANSACTION_TYPE] = "BUY"
			)
			-
			CALCULATE (
			    SUM ( 'FACT_HOLDINGS'[VALUE_SAR] ),
			    'FACT_HOLDINGS'[TRANSACTION_TYPE] = "SELL"
			)
		formatString: #,0
		displayFolder: Currency
		lineageTag: 4e8b2c6d-0a1f-4b3e-9c7d-5f2a8e4b1c63

	measure 'Current FX Exposure %' = DIVIDE ( [Current FX Exposure (SAR)], CALCULATE ( [Current FX Exposure (SAR)], REMOVEFILTERS ( DIM_CURRENCY ) ) )
		formatString: 0.00%
		displayFolder: Currency
		lineageTag: 9c2e4f6a-1b3d-4e5f-8a7b-3d5f7a9c1e42

	measure 'CF FX Exposure Color' =
			VAR v = [Current FX Exposure (SAR)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 3a7c9e1f-5b2d-4f8a-b6c4-8e0a2c4d6f53


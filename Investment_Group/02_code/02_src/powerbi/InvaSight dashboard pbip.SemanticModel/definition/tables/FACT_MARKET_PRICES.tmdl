table FACT_MARKET_PRICES
	lineageTag: 59aca29a-3ec8-4e00-ad00-b8fde0b0f069

	measure 'Avg Price (SAR)' = AVERAGE ( FACT_MARKET_PRICES[PRICE_SAR] )
		formatString: #,0.00
		displayFolder: Market
		lineageTag: 7e0ccf4e-4676-4baf-8975-ceddd3809f05

	measure 'Latest Price (SAR)' =
			VAR MaxDate = CALCULATE ( MAX ( DIM_DATE[FULL_DATE] ), FACT_MARKET_PRICES )
			RETURN
			    CALCULATE ( AVERAGE ( FACT_MARKET_PRICES[PRICE_SAR] ), DIM_DATE[FULL_DATE] = MaxDate )
		formatString: #,0.00
		displayFolder: Market
		lineageTag: fcc0c317-dd68-4909-9f5e-24c394141f9a

	measure 'Price Change %' =
			VAR PricedRows = FILTER ( FACT_MARKET_PRICES, NOT ISBLANK ( FACT_MARKET_PRICES[PRICE_SAR] ) )
			VAR MinDate = MINX ( PricedRows, RELATED ( DIM_DATE[FULL_DATE] ) )
			VAR MaxDate = MAXX ( PricedRows, RELATED ( DIM_DATE[FULL_DATE] ) )
			VAR FirstPrice = CALCULATE ( AVERAGE ( FACT_MARKET_PRICES[PRICE_SAR] ), DIM_DATE[FULL_DATE] = MinDate )
			VAR LastPrice = CALCULATE ( AVERAGE ( FACT_MARKET_PRICES[PRICE_SAR] ), DIM_DATE[FULL_DATE] = MaxDate )
			RETURN
			    DIVIDE ( LastPrice - FirstPrice, FirstPrice )
		formatString: 0.00%
		displayFolder: Market
		lineageTag: e22f906c-29cc-4739-9647-a4ac95e28961

	measure 'CF Price Change Color' =
			VAR v = [Price Change %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 3e0aa913-5d15-4034-857e-0a475ebab726

	measure 'Price Index (Start = 100)' =
			VAR StartDate =
			    CALCULATE (
			        MINX (
			            FILTER ( FACT_MARKET_PRICES, NOT ISBLANK ( FACT_MARKET_PRICES[PRICE_SAR] ) ),
			            RELATED ( DIM_DATE[FULL_DATE] )
			        ),
			        ALLSELECTED ( DIM_DATE )
			    )
			VAR StartPrice = CALCULATE ( [Avg Price (SAR)], ALLSELECTED ( DIM_DATE ), DIM_DATE[FULL_DATE] = StartDate )
			RETURN
			    DIVIDE ( [Avg Price (SAR)], StartPrice ) * 100
		formatString: #,0.0
		displayFolder: Market
		lineageTag: a5a2f824-19bf-4676-95c5-34af90d3eee1


	partition FACT_MARKET_PRICES = m
		mode: directQuery
		source =
				let
				    Source = Snowflake.Databases("ltzxtcl-ax57527.snowflakecomputing.com","INVASIGHT_WH",[Implementation="2.0"]),
				    INVASIGHT_Database = Source{[Name="INVASIGHT",Kind="Database"]}[Data],
				    ANALYTICS_Schema = INVASIGHT_Database{[Name="ANALYTICS",Kind="Schema"]}[Data],
				    FACT_MARKET_PRICES_Table = ANALYTICS_Schema{[Name="FACT_MARKET_PRICES",Kind="Table"]}[Data]

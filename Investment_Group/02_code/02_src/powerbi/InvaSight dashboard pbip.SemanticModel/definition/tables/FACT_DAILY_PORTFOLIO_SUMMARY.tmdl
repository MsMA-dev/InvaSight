table FACT_DAILY_PORTFOLIO_SUMMARY
	lineageTag: 56e2f801-eb5f-405e-9b55-00ab242ca3c6

	measure 'Portfolio Value (SAR)' =
			VAR MaxDate = CALCULATE ( MAX ( DIM_DATE[FULL_DATE] ), FACT_DAILY_PORTFOLIO_SUMMARY )
			RETURN
			    CALCULATE ( SUM ( FACT_DAILY_PORTFOLIO_SUMMARY[PORTFOLIO_VALUE_SAR] ), DIM_DATE[FULL_DATE] = MaxDate )
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 7c28a48e-6717-4f19-b15d-194940dd30d5

	measure 'Total Investment (SAR)' =
			VAR MaxDate = CALCULATE ( MAX ( DIM_DATE[FULL_DATE] ), FACT_DAILY_PORTFOLIO_SUMMARY )
			RETURN
			    CALCULATE ( SUM ( FACT_DAILY_PORTFOLIO_SUMMARY[TOTAL_INVESTMENT] ), DIM_DATE[FULL_DATE] = MaxDate )
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 2f2231cc-5d9d-45ed-9388-a3fd2d2337b8

	measure 'P&L (SAR)' = [Portfolio Value (SAR)] - [Total Investment (SAR)]
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 57d196ac-4d7a-4379-b70b-957dce052d75

	measure 'Return %' = DIVIDE ( [P&L (SAR)], [Total Investment (SAR)] )
		formatString: 0.00%
		displayFolder: Portfolio
		lineageTag: 1c329b5c-2a47-4278-8ef5-fd4fca6d7cb7

	measure 'Avg Daily Return %' = AVERAGE ( FACT_DAILY_PORTFOLIO_SUMMARY[DAILY_RETURN] )
		formatString: 0.00"%"
		displayFolder: Portfolio
		lineageTag: b23bda02-902d-47d2-9a9d-588a7a7d4a2d

	measure 'Currency Exposure (SAR)' =
			VAR MaxDate = CALCULATE ( MAX ( DIM_DATE[FULL_DATE] ), FACT_DAILY_PORTFOLIO_SUMMARY )
			RETURN
			    CALCULATE ( SUM ( FACT_DAILY_PORTFOLIO_SUMMARY[CURRENCY_EXPOSURE_SAR] ), DIM_DATE[FULL_DATE] = MaxDate )
		formatString: #,0
		displayFolder: Portfolio
		lineageTag: 079609a4-1166-4d51-8c58-70b8ca551c30

	measure 'CF P&L Color' =
			VAR v = [P&L (SAR)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 234894d8-af04-4365-8de7-dfb9340eeaeb

	measure 'CF Return Color' =
			VAR v = [Return %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 1b07674e-28e9-4321-a9de-14b666a946f1

	measure 'CF Avg Daily Return Color' =
			VAR v = [Avg Daily Return %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 3847783c-3457-4b09-8ba1-cc904b7d0b7f

	measure 'CF Portfolio Value Color' =
			VAR v = [Portfolio Value (SAR)]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( v ), BLANK (), v < 0, "#A4262C", "#2b6136" )
		displayFolder: Formatting
		lineageTag: 68a73e17-020f-4187-b841-2a4d61d5bf86

